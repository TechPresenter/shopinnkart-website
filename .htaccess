# ===========================================================================
#  ShopInnKart - Apache configuration
#  Clean URLs, security hardening, compression and caching.
# ===========================================================================

# --- Default document -------------------------------------------------------
DirectoryIndex index.php index.html

# --- Never list a directory -------------------------------------------------
Options -Indexes +FollowSymLinks

# --- Custom error documents -------------------------------------------------
# ErrorDocument only accepts a document-root-relative path, which cannot be
# written portably for a sub-folder install (a bare "404.php" is treated as a
# literal message, not a path). So the branded 403 and 404 are served by the
# rewrite rules below instead, and this stays as the last-resort handler for
# server-level 500s. PHP fatals never reach it — ErrorHandler renders 500.php
# itself.
ErrorDocument 500 /500.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # No RewriteBase on purpose. Without it, mod_rewrite resolves relative
    # substitutions against the directory holding this file, so the project
    # works unchanged at the domain root OR in a sub-folder like /ecomweb.
    # Hard-coding "RewriteBase /" breaks every clean URL in a sub-folder.

    # HTTPS is NOT forced here any more. A commented-out block is a security
    # control that depends on someone reading a deployment doc; this one was
    # never uncommented. includes/security-headers.php does it instead, driven
    # by the sec_force_https setting on Admin > Security > Settings, which also
    # sends HSTS and can be switched off from the same screen if TLS breaks.

    # Strip a trailing slash from non-directory URLs. The target comes from
    # REQUEST_URI (already the full URL path, sub-folder included) rather than
    # the per-directory match: a relative "$1" in a redirect gets the folder's
    # FILESYSTEM path prefixed when there is no RewriteBase, which sent
    # /shop/ to http://host/C:/xampp/htdocs/ecomweb/shop.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !/api/
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^.+/$ %1 [L,R=301]

    # ---------------------------------------------------------------
    #  Clean URLs
    # ---------------------------------------------------------------
    RewriteRule ^product/([a-zA-Z0-9\-_]+)/?$        product.php?slug=$1     [L,QSA]
    RewriteRule ^combo/([a-zA-Z0-9\-_]+)/?$          combo.php?slug=$1       [L,QSA]
    RewriteRule ^combos/?$                           combos.php              [L,QSA]
    RewriteRule ^category/([a-zA-Z0-9\-_]+)/?$       category.php?slug=$1    [L,QSA]
    RewriteRule ^brand/([a-zA-Z0-9\-_]+)/?$          brand.php?slug=$1       [L,QSA]
    RewriteRule ^page/([a-zA-Z0-9\-_]+)/?$           page.php?slug=$1        [L,QSA]
    RewriteRule ^blog/?$                             blog.php                [L,QSA]
    RewriteRule ^blog/category/([a-zA-Z0-9\-_]+)/?$  blog.php?category=$1    [L,QSA]
    RewriteRule ^blog/([a-zA-Z0-9\-_]+)/?$           blog-post.php?slug=$1   [L,QSA]
    RewriteRule ^order/([A-Za-z0-9\-]+)/?$           order-details.php?order=$1 [L,QSA]

    RewriteRule ^shop/?$          shop.php          [L,QSA]
    RewriteRule ^search/?$        search.php        [L,QSA]
    RewriteRule ^deals/?$         deals.php         [L,QSA]
    RewriteRule ^new-arrivals/?$  new-arrivals.php  [L,QSA]
    RewriteRule ^best-sellers/?$  best-sellers.php  [L,QSA]
    RewriteRule ^brands/?$        brands.php        [L,QSA]
    RewriteRule ^cart/?$          cart.php          [L,QSA]
    RewriteRule ^checkout/?$      checkout.php      [L,QSA]
    RewriteRule ^wishlist/?$      wishlist.php      [L,QSA]
    RewriteRule ^compare/?$       compare.php       [L,QSA]
    RewriteRule ^track-order/?$   track-order.php   [L,QSA]
    RewriteRule ^account/?$       account.php       [L,QSA]
    RewriteRule ^login/?$         login.php         [L,QSA]
    RewriteRule ^register/?$      register.php      [L,QSA]
    RewriteRule ^logout/?$        logout.php        [L,QSA]
    RewriteRule ^contact/?$       contact.php       [L,QSA]
    RewriteRule ^about/?$         about.php         [L,QSA]
    RewriteRule ^faq/?$           faq.php           [L,QSA]
    RewriteRule ^sitemap\.xml$    sitemap.php       [L]
    # The section files the index points at: /sitemap-products-1.xml and
    # friends. Without this rule they would fall through to 404.php, because
    # the catch-all below only rewrites extensionless paths. The page number
    # is optional so /sitemap-blog.xml also resolves, to page 1.
    RewriteRule ^sitemap-([a-z]+)(?:-([0-9]+))?\.xml$  sitemap.php?type=$1&page=$2  [L,QSA]
    # robots.txt is generated, not a file on disk: the Sitemap line has to name
    # whatever host is actually serving the site, and the operator can append
    # rules from the admin panel.
    RewriteRule ^robots\.txt$     robots.php        [L]

    # Anything else that is not a real file/folder and has no extension
    # falls through to the .php file of the same name.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
    RewriteRule ^([a-zA-Z0-9\-_]+)/?$ $1.php [L,QSA]

    # ---------------------------------------------------------------
    #  Branded error pages
    #  Served by rewriting rather than ErrorDocument, because that
    #  directive cannot express a sub-folder-relative path. Each target
    #  sets its own HTTP status, so the response code is still correct.
    # ---------------------------------------------------------------

    # Note: the server-side directories are NOT rewritten to 403.php. Apache
    # runs authorization before per-directory mod_rewrite, so the deny-all
    # .htaccess inside each one answers first with a bare 403. That is the
    # right order — the hard deny should win over cosmetics, and a plain 403
    # on a path no customer ever visits leaks less than a styled one.
    # 403.php is still used where a real person can land on it: an order that
    # is not theirs, or an admin page their role does not cover.

    # Everything left over is genuinely missing.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !/api/
    RewriteRule ^ 404.php [L]
</IfModule>

# ===========================================================================
#  Security
# ===========================================================================

# Everything in this section answers 404, not 403. A 403 is an answer: it says
# "this exists and is protected", which is how a scanner maps an application it
# cannot see. 404 is what the rest of the site says about a path that is not
# there, so the internals look like nothing at all. RedirectMatch runs during
# URL translation, before authorization and before per-directory rewrites, so
# these win over everything below.

# --- Dot-files AND dot-folders ----------------------------------------------
# The old <FilesMatch "^\."> matched only the LAST path segment, so /.git/config
# was served happily: the file is called "config". This matches a dot anywhere
# in the path, which is what closes /.git/ - the whole source tree and its
# history, schema.sql and the seeded admin hash included.
# .well-known stays open: Let's Encrypt and Apple/Google app links need it.
# Deliberately NOT case-insensitive, unlike the rules below. A dot has no case,
# so /.GIT/ and /.Env are already caught; leaving the exception lowercase means
# only the real, lowercase /.well-known/ is let through.
RedirectMatch 404 "/\.(?!well-known/)"

# Every pattern below is written (?i) - case-insensitive. RedirectMatch is a
# case-SENSITIVE regex by default (it has no [NC] flag of its own), and the
# rules are matched against the URL, not against the file the URL resolves to.
# On any case-insensitive filesystem - Windows here, macOS, and a surprising
# number of shared hosts - /README.MD and /Config/db.local.PHP resolve to the
# same files as their lowercase spellings while sailing past a lowercase
# pattern. So the deny list was one shift key away from being optional.
# (Linux hosts resolve neither, which is why this never showed up in testing.)

# --- Server-side folders ----------------------------------------------------
# Not anchored at ^/ so they still match when the app lives in a sub-folder.
# Each of these directories also carries its own deny-all .htaccess, so the
# protection survives a host that ignores this file, and the PHP files inside
# them refuse a web SAPI in code as a third line.
RedirectMatch 404 "(?i)/config/.*$"
RedirectMatch 404 "(?i)/storage/.*$"
RedirectMatch 404 "(?i)/database/.*$"
RedirectMatch 404 "(?i)/includes/.*$"
RedirectMatch 404 "(?i)/vendor/.*$"
RedirectMatch 404 "(?i)/bin/.*$"
RedirectMatch 404 "(?i)/docs/.*$"
RedirectMatch 404 "(?i)/admin/includes/.*$"
RedirectMatch 404 "(?i)/admin/security/cards/.*$"

# --- Sensitive extensions ---------------------------------------------------
# Dumps, logs, backups, dependency manifests and editor leftovers. .json covers
# composer.json and package.json; no public route ends in .json (the API serves
# JSON from .php endpoints).
RedirectMatch 404 "(?i)\.(sql|log|ini|md|lock|bak|old|orig|save|swp|swo|dist|tpl|yml|yaml|json|sh|bat|cmd|ps1|sqlite|sqlite3|db|env|pem|key|crt|tar|gz|zip)$"

# --- Include-only partials are never entry points ---------------------------
# Anything named _something.php is meant to be require()d by a page that has
# already run its auth checks. Requesting one directly would skip those checks.
RedirectMatch 404 "(?i)/_[^/]*\.php$"

# --- Uploads must never execute --------------------------------------------
# A PHP file smuggled into /uploads is served as plain text, not run.
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} /uploads/.*\.(php|phtml|php3|php4|php5|php7|phps|pl|py|jsp|asp|sh|cgi)$ [NC]
    RewriteRule .* - [F,L]
</IfModule>

# --- Uploaded SVGs are sandboxed -------------------------------------------
# upload_image() rewrites every uploaded SVG from an allowlist, so nothing
# scriptable should reach disk. This is the second line: an SVG opened directly
# is served with no script, plugin or network privileges of its own, so even a
# sanitiser bypass cannot reach the session cookie.
<IfModule mod_headers.c>
    <FilesMatch "(?i)\.svg$">
        Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
        Header always set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

# --- Security headers for STATIC files only ---------------------------------
# Every dynamic response gets its headers from includes/security-headers.php.
# They used to be set in both places, so each one went out twice and the
# Permissions-Policy here (microphone=()) silently disabled the site's own
# voice search. Apache only owns what PHP never sees: files served off disk.
#
# "Header unset Server" was here too and does nothing - the Server header is
# added after .htaccess runs. It belongs in httpd.conf as
# "ServerTokens Prod" + "ServerSignature Off"; on Hostinger, ask support.
<IfModule mod_headers.c>
    <FilesMatch "(?i)\.(css|js|map|svg|webp|jpg|jpeg|png|gif|ico|woff2?|txt|xml|webmanifest)$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
    </FilesMatch>
    Header always unset X-Powered-By
</IfModule>

# --- Hide the PHP version ---------------------------------------------------
<IfModule mod_php.c>
    php_flag expose_php off
</IfModule>

# ===========================================================================
#  Performance
# ===========================================================================

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml application/vnd.ms-fontobject font/ttf font/otf
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Browser caching --------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"

    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType application/json          "access plus 0 seconds"

    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"

    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"

    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|webp|jpg|jpeg|png|gif|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # No rule for .php on purpose. "Header set" REPLACES what PHP sent, and the
    # value here (no-cache, must-revalidate) is weaker than the "no-store" that
    # json_response() and every account page send - so carts, addresses and API
    # JSON became disk-cacheable. PHP decides its own caching now.
</IfModule>

# --- Correct MIME types -----------------------------------------------------
<IfModule mod_mime.c>
    AddType image/svg+xml   .svg
    AddType image/webp      .webp
    AddType font/woff2      .woff2
    AddType application/json .json
</IfModule>

# --- Upload limits ----------------------------------------------------------
<IfModule mod_php.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 12M
    php_value max_execution_time 120
    php_value memory_limit 256M
</IfModule>
