# ShopInnKart

# Local credentials — never commit these
config/db.local.php
config/mail.local.php
# Encrypts stored SMTP passwords. Losing it means re-entering them; leaking it
# means they can be read out of the settings table.
config/app.key.php

# Runtime
storage/logs/*
storage/cache/*
storage/backups/*
storage/installed.lock
# Runtime locks (the courier poller, and any later cron job)
storage/*.lock
!storage/logs/.gitkeep
!storage/cache/.gitkeep

# Generated tax invoices — regenerable from the invoice records, and customer
# financial data has no business in a repository.
storage/invoices/*
!storage/invoices/.gitkeep

# Customer uploads (keep the folder structure, not the files)
uploads/products/*
uploads/categories/*
uploads/brands/*
uploads/banners/*
uploads/blog/*
uploads/users/*
# Admin-uploaded logo/favicon. The packaged brand assets live in
# assets/images/logo/, which is what brand.php falls back to, so a fresh
# clone still renders a logo without carrying one account's upload.
uploads/branding/*
!uploads/**/.gitkeep

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
config/db.production.php

# Working files from audits and QA runs, not part of the application.
.admin-audit-journal.jsonl
FRONTEND-AUDIT.md

# bin/ holds the CLI workers the LIVE site runs from cron - the email queue,
# the courier tracking poller, the hidden-admin-URL recovery and the security
# self-test. It was ignored as "local-only helper scripts" while it held
# throwaway scripts; with those jobs in it, a Git deploy left the server with
# no worker to schedule while docs/HOSTING.md told the owner to schedule them.
# Anything genuinely throwaway belongs in the scratch directory, not here.

# Generated database export for a live host. Contains admin password hashes
# and customer rows - regenerate it with database/export-for-hosting.php
# rather than committing one.
database/shopinnkart-import.sql

# Temporary copies of workflow scripts so they can be resumed after a restart.
.wf/
